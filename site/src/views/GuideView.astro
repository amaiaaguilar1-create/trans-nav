---
/** Renders one document guide (name change, DL, birth certificate, or a federal document). */
import { t, type Locale } from '../i18n/ui';
import { lt } from '../lib/content';
import type { DocumentGuide } from '../types/content';
import StatusBanner from '../components/StatusBanner.astro';
import Steps from '../components/Steps.astro';
import Forms from '../components/Forms.astro';
import Fees from '../components/Fees.astro';
import Sources from '../components/Sources.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Cite from '../components/Cite.astro';
import Md from '../components/Md.astro';

const { guide, locale } = Astro.props as { guide: DocumentGuide; locale: Locale };
const _ = t(locale);
const index = new Map(guide.sources.map((s, i) => [s.id, i + 1]));
const yn = (v: 'yes' | 'no' | 'conditional') => _(`yesno.${v}` as const);
---
<StatusBanner
  locale={locale}
  status={guide.status}
  nameChangeStatus={guide.name_change_status}
  markers={guide.markers_available}
  summary={guide.status_summary}
  review={guide.review}
/>

<section>
  <h2 id="summary">{_('section.summary')}</h2>
  <Md text={lt(guide.summary, locale)} />
</section>

{guide.litigation && guide.litigation.length > 0 && (
  <section>
    <h2 id="litigation">{_('section.litigation')}</h2>
    {guide.litigation.map((l) => (
      <div class="notice info">
        <p><strong>{l.case}</strong>{l.court ? ` (${l.court})` : ''} · <time datetime={l.last_update}>{l.last_update}</time> <Cite ids={l.sources} index={index} /></p>
        <p>{lt(l.summary, locale)}</p>
        <p><strong>{lt(l.effect_today, locale)}</strong></p>
        {l.url && <p><a href={l.url} rel="noopener">{l.url.replace(/^https?:\/\//, '').split('/')[0]}</a></p>}
      </div>
    ))}
  </section>
)}

{guide.eligibility && (
  <section>
    <h2 id="eligibility">{_('section.eligibility')} <Cite ids={guide.eligibility.sources} index={index} /></h2>
    <dl class="kv">
      {guide.eligibility.residency && <><dt>Residency</dt><dd>{lt(guide.eligibility.residency, locale)}</dd></>}
      {guide.eligibility.age && <><dt>Age</dt><dd>{lt(guide.eligibility.age, locale)}</dd></>}
      {guide.eligibility.criminal_history && <><dt>Criminal history</dt><dd>{lt(guide.eligibility.criminal_history, locale)}</dd></>}
      {guide.eligibility.other && <><dt>Other</dt><dd>{lt(guide.eligibility.other, locale)}</dd></>}
    </dl>
  </section>
)}

<section>
  <h2 id="steps">{_('section.steps')}</h2>
  <Steps steps={guide.steps} forms={guide.forms} fees={guide.fees} locale={locale} index={index} />
</section>

{guide.forms && guide.forms.length > 0 && (
  <section>
    <h2 id="forms">{_('section.forms')}</h2>
    <Forms forms={guide.forms} locale={locale} index={index} />
  </section>
)}

{guide.fees && guide.fees.length > 0 && (
  <section>
    <h2 id="costs">{_('section.fees')}</h2>
    <Fees fees={guide.fees} locale={locale} index={index} />
    {guide.fee_waiver && (
      <>
        <h3>{_('section.fee_waiver')} <Cite ids={guide.fee_waiver.sources} index={index} /></h3>
        {guide.fee_waiver.available ? (
          <>
            {guide.fee_waiver.eligibility && <Md text={lt(guide.fee_waiver.eligibility, locale)} />}
            {guide.fee_waiver.how && <Md text={lt(guide.fee_waiver.how, locale)} />}
            {guide.fee_waiver.forms && guide.fee_waiver.forms.length > 0 && <p>{guide.fee_waiver.forms.map((f) => <a href={`#form-${f}`} style="margin-right:.6rem">📄 {f}</a>)}</p>}
          </>
        ) : <p>{_('yesno.no')}</p>}
      </>
    )}
  </section>
)}

{(guide.publication || guide.hearing || guide.background_check || guide.confidentiality || guide.delivery) && (
  <section>
    <h2 id="details">Details</h2>
    <dl class="kv">
      {guide.publication && <><dt>{_('section.publication')}</dt><dd>{yn(guide.publication.required)} <Cite ids={guide.publication.sources} index={index} />{guide.publication.detail && <div><Md text={lt(guide.publication.detail, locale)} /></div>}{guide.publication.waiver_how && <div><Md text={lt(guide.publication.waiver_how, locale)} /></div>}</dd></>}
      {guide.hearing && <><dt>{_('section.hearing')}</dt><dd>{yn(guide.hearing.required)} <Cite ids={guide.hearing.sources} index={index} />{guide.hearing.detail && <div><Md text={lt(guide.hearing.detail, locale)} /></div>}</dd></>}
      {guide.background_check && <><dt>{_('section.background_check')}</dt><dd>{yn(guide.background_check.required)} <Cite ids={guide.background_check.sources} index={index} />{guide.background_check.detail && <div><Md text={lt(guide.background_check.detail, locale)} /></div>}</dd></>}
      {guide.confidentiality && <><dt>{_('section.confidentiality')}</dt><dd>{guide.confidentiality.sealing_available ? _('yesno.yes') : _('yesno.no')} <Cite ids={guide.confidentiality.sources} index={index} />{guide.confidentiality.detail && <div><Md text={lt(guide.confidentiality.detail, locale)} /></div>}{guide.confidentiality.how && <div><Md text={lt(guide.confidentiality.how, locale)} /></div>}</dd></>}
      {guide.delivery && <><dt>{_('section.delivery')}</dt><dd>{[guide.delivery.online && 'Online', guide.delivery.by_mail && 'Mail', guide.delivery.in_person && 'In person'].filter(Boolean).join(' · ')} <Cite ids={guide.delivery.sources} index={index} />{guide.delivery.detail && <div><Md text={lt(guide.delivery.detail, locale)} /></div>}</dd></>}
    </dl>
  </section>
)}

{guide.minors && (
  <section>
    <h2 id="minors">{_('section.minors')} <Cite ids={guide.minors.sources} index={index} /></h2>
    <Md text={lt(guide.minors.summary, locale)} />
    {guide.minors.forms && guide.minors.forms.length > 0 && <p>{guide.minors.forms.map((f) => <a href={`#form-${f}`} style="margin-right:.6rem">📄 {f}</a>)}</p>}
  </section>
)}

{guide.timeline && (
  <section>
    <h2 id="timeline">{_('section.timeline')}</h2>
    <Md text={lt(guide.timeline, locale)} />
  </section>
)}

{guide.after && (
  <section>
    <h2 id="after">{_('section.after')}</h2>
    <Md text={lt(guide.after, locale)} />
  </section>
)}

{guide.tips && guide.tips.length > 0 && (
  <section>
    <h2 id="tips">{_('section.tips')}</h2>
    <ul>{guide.tips.map((tip) => <li>{lt(tip, locale)}</li>)}</ul>
  </section>
)}

{guide.local_help && guide.local_help.length > 0 && (
  <section>
    <h2 id="local-help">{_('section.local_help')}</h2>
    <div class="cards">{guide.local_help.map((r) => <ResourceCard r={r} locale={locale} index={index} />)}</div>
  </section>
)}

{guide.pending_bills && guide.pending_bills.length > 0 && (
  <section>
    <h2 id="bills">{_('section.pending_bills')}</h2>
    <ul>{guide.pending_bills.map((b) => <li><strong>{b.url ? <a href={b.url} rel="noopener">{b.bill}</a> : b.bill}</strong> ({b.status.replace(/_/g, ' ')}, {b.last_action}) — {lt(b.summary, locale)} <Cite ids={b.sources} index={index} /></li>)}</ul>
  </section>
)}

{guide.statutes && guide.statutes.length > 0 && (
  <section>
    <h2 id="law">{_('section.statutes')}</h2>
    <ul>{guide.statutes.map((c) => <li><a href={c.url} rel="noopener">{c.cite}</a>{c.title ? ` — ${lt(c.title, locale)}` : ''}</li>)}</ul>
  </section>
)}

{guide.related_links && guide.related_links.length > 0 && (
  <section>
    <h2 id="related">{_('section.related_links')}</h2>
    <ul>{guide.related_links.map((l) => <li><a href={l.url} rel="noopener">{l.title}</a>{l.note ? ` — ${lt(l.note, locale)}` : ''}</li>)}</ul>
  </section>
)}

<Sources sources={guide.sources} locale={locale} />
