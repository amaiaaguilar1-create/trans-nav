---
/**
 * Every jurisdiction side by side. Columns are grouped by question (name, gender marker, care, protections) so a marker
 * restriction never reads as a name restriction. A toggle adds the second layer: what each marker change requires.
 */
import { t, type Locale } from '../i18n/ui';
import { lt, localePath, type StateBundle } from '../lib/content';
import { tx, type Status } from '../lib/text';
import { answerWord, markerDetail } from '../lib/verdict';
import StatusChip from '../components/StatusChip.astro';
import Term from '../components/Term.astro';
const { states, locale } = Astro.props as { states: StateBundle[]; locale: Locale };
const _ = t(locale);
type Cell = { status?: Status; answer?: string; detail?: string; x?: boolean; href: string };
const rows = [...states].sort((a, b) => lt(a.meta.name, locale).localeCompare(lt(b.meta.name, locale), locale)).map((s) => {
  const base = `states/${s.code.toLowerCase()}`;
  const nc = s.guides.name_change, dl = s.guides.drivers_license, bc = s.guides.birth_certificate;
  const cell = (st: Status | undefined, href: string, kind: 'doc' | 'care' = 'doc', extra: Partial<Cell> = {}): Cell => ({ status: st, answer: st ? answerWord(st, locale, kind) : undefined, href, ...extra });
  return {
    code: s.code, name: lt(s.meta.name, locale), href: localePath(locale, base), shield: !!s.meta.climate.shield_law,
    cells: {
      nc: cell(nc?.status, localePath(locale, `${base}/name-change`)),
      dl: cell(dl?.status, localePath(locale, `${base}/drivers-license`), 'doc', { x: !!dl?.markers_available?.includes('X'), detail: dl ? markerDetail(dl, locale) : undefined }),
      bc: cell(bc?.status, localePath(locale, `${base}/birth-certificate`), 'doc', { x: !!bc?.markers_available?.includes('X'), detail: bc ? markerDetail(bc, locale) : undefined }),
      adult: cell(s.care?.adult_care.status, localePath(locale, `${base}/care`), 'care'),
      minor: cell(s.care?.minor_care.status, localePath(locale, `${base}/care`), 'care'),
    },
  };
});
const cols = ['nc', 'dl', 'bc', 'adult', 'minor'] as const;
const ncLimited = rows.filter((r) => r.cells.nc.status && r.cells.nc.status !== 'available').length;
---
<div class="key-point">
  <p><strong>{tx(locale, `You can legally change your name in all ${rows.length} states and territories.`, `Puedes cambiar legalmente tu nombre en los ${rows.length} estados y territorios.`)}</strong> {tx(locale, `${ncLimited} add extra steps, like a newspaper notice or a hearing. Changing the gender marker is a separate question, and it is where states differ most.`, `${ncLimited} agregan pasos, como un aviso en el periódico o una audiencia. Cambiar el marcador de género es otra pregunta, y es donde los estados más se diferencian.`)}</p>
</div>

<div class="compare-controls" data-compare-controls>
  <label>{tx(locale, 'Find a state', 'Buscar un estado')}<input type="search" data-q autocomplete="off" placeholder={tx(locale, 'For example, Ohio or OH', 'Por ejemplo, Ohio u OH')} /></label>
  <label>{tx(locale, 'Show only states where', 'Mostrar solo estados donde')}
    <select data-f>
      <option value="">{tx(locale, 'Show all', 'Mostrar todos')}</option>
      <optgroup label={tx(locale, 'Gender marker', 'Marcador de género')}>
        <option value="dl:available">{tx(locale, 'License marker can be changed', 'Se puede cambiar el marcador en la licencia')}</option>
        <option value="dlx">{tx(locale, 'License offers X', 'La licencia ofrece X')}</option>
        <option value="bc:available">{tx(locale, 'Birth certificate marker can be changed', 'Se puede cambiar el marcador en el acta')}</option>
        <option value="bcx">{tx(locale, 'Birth certificate offers X', 'El acta ofrece X')}</option>
      </optgroup>
      <optgroup label={tx(locale, 'Care and protections', 'Atención y protecciones')}>
        <option value="minor:available">{tx(locale, 'Care for under-18s is allowed', 'La atención a menores está permitida')}</option>
        <option value="shield">{tx(locale, 'Has a shield law', 'Tiene ley escudo')}</option>
      </optgroup>
    </select>
  </label>
  <label class="check"><input type="checkbox" data-detail /> {tx(locale, 'Show what you need for each marker change', 'Mostrar qué necesitas para cada cambio de marcador')}</label>
  <p class="small muted compare-count" data-count aria-live="polite"></p>
</div>

<div class="table-wrap tall">
  <table class="data compare">
    <caption class="visually-hidden">{tx(locale, 'What each state allows, by question', 'Lo que permite cada estado, por pregunta')}</caption>
    <thead>
      <tr class="group-row">
        <td></td>
        <th scope="colgroup" colspan="1">{tx(locale, 'Name', 'Nombre')}</th>
        <th scope="colgroup" colspan="2"><Term id="gender-marker" locale={locale}>{tx(locale, 'Gender marker', 'Marcador de género')}</Term></th>
        <th scope="colgroup" colspan="2">{tx(locale, 'Gender-affirming care', 'Atención de afirmación de género')}</th>
        <th scope="colgroup">{tx(locale, 'Protection', 'Protección')}</th>
      </tr>
      <tr>
        <th scope="col">{tx(locale, 'State', 'Estado')}</th>
        <th scope="col" class="g-start">{tx(locale, 'Court name change', 'Cambio judicial')}</th>
        <th scope="col" class="g-start">{tx(locale, 'License or ID', 'Licencia o ID')}</th>
        <th scope="col">{tx(locale, 'Birth certificate', 'Acta de nacimiento')}</th>
        <th scope="col" class="g-start">{tx(locale, 'Adults', 'Adultos')}</th>
        <th scope="col">{tx(locale, 'Under 18', 'Menores')}</th>
        <th scope="col" class="g-start"><Term id="shield-law" locale={locale}>{_('climate.shield_law')}</Term></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-name={`${r.name} ${r.code}`.toLowerCase()} data-dl={r.cells.dl.status} data-bc={r.cells.bc.status} data-minor={r.cells.minor.status} data-dlx={String(r.cells.dl.x)} data-bcx={String(r.cells.bc.x)} data-shield={String(r.shield)}>
          <th scope="row"><a href={r.href}>{r.name}</a></th>
          {cols.map((c) => { const x = r.cells[c]; return (
            <td class={c === 'nc' || c === 'dl' || c === 'adult' ? 'g-start' : ''}>
              {x.status ? <a class="cell-link" href={x.href}><StatusChip status={x.status} locale={locale} size="sm" variant="mark" text={x.answer} />{x.x && <span class="x-flag" title={tx(locale, 'X offered', 'Se ofrece X')}>X</span>}</a> : <span class="muted xs">{tx(locale, 'No data', 'Sin datos')}</span>}
              {x.detail && <span class="cell-detail">{x.detail}</span>}
            </td>
          ); })}
          <td class="g-start">{r.shield ? _('yesno.yes') : _('yesno.no')}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<div class="empty" data-none hidden>
  <p><strong>{tx(locale, 'No states match both the search and the filter.', 'Ningún estado coincide con la búsqueda y el filtro.')}</strong></p>
  <button type="button" class="btn sm secondary" data-clear>{tx(locale, 'Clear search and filter', 'Borrar búsqueda y filtro')}</button>
</div>
<p class="small muted prose" style="margin-top:1rem">{tx(locale, 'Birth certificate rules follow the state where you were born, not where you live. Federal documents (passport, Social Security) are the same everywhere and are not in this table. Every page is a draft until a person verifies it.', 'Las reglas del acta de nacimiento dependen del estado donde naciste, no donde vives. Los documentos federales (pasaporte, Seguro Social) son iguales en todas partes y no están en esta tabla. Cada página es un borrador hasta que una persona la verifique.')}</p>
<script>
  const q = document.querySelector<HTMLInputElement>('[data-q]')!, f = document.querySelector<HTMLSelectElement>('[data-f]')!, d = document.querySelector<HTMLInputElement>('[data-detail]')!;
  const table = document.querySelector<HTMLTableElement>('table.compare')!;
  const rows = [...table.querySelectorAll<HTMLTableRowElement>('tbody tr')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const lang = document.documentElement.lang;
  const apply = () => {
    const text = q.value.trim().toLowerCase(), [k, v] = f.value.split(':');
    let n = 0;
    for (const r of rows) {
      const okText = !text || r.dataset.name!.includes(text);
      const okFilter = !k || (v ? r.dataset[k] === v : r.dataset[k] === 'true');
      r.hidden = !(okText && okFilter); if (!r.hidden) n++;
    }
    document.querySelector<HTMLElement>('[data-none]')!.hidden = n > 0;
    count.textContent = lang === 'es' ? `Mostrando ${n} de ${rows.length}` : `Showing ${n} of ${rows.length}`;
  };
  q.addEventListener('input', apply); f.addEventListener('change', apply);
  document.querySelector('[data-clear]')!.addEventListener('click', () => { q.value = ''; f.value = ''; apply(); q.focus(); });
  d.addEventListener('change', () => table.classList.toggle('show-detail', d.checked));
  apply();
</script>
