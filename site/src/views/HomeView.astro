---
import { t, type Locale } from '../i18n/ui';
import { localePath, type StateBundle } from '../lib/content';
import { tx } from '../lib/text';
import type { DocumentGuide } from '../types/content';
import StatusChip from '../components/StatusChip.astro';
import StatesGrid from '../components/StatesGrid.astro';
import StatePicker from '../components/StatePicker.astro';
import Route from '../components/Route.astro';
import Icon from '../components/Icon.astro';
import Term from '../components/Term.astro';
import { docVerdict } from '../lib/verdict';

const { states, federal, locale } = Astro.props as { states: StateBundle[]; federal: DocumentGuide[]; locale: Locale };
const _ = t(locale);
const order = ['passport', 'social_security', 'uscis', 'tsa_global_entry'];
const fed = [...federal].sort((a, b) => order.indexOf(a.guide_type) - order.indexOf(b.guide_type));
const journey = [
  { title: tx(locale, 'Court order for your new name', 'Orden judicial con tu nuevo nombre'), note: tx(locale, 'Filed in your state. Fees, newspaper notices, and hearings vary a lot.', 'Se presenta en tu estado. Las tarifas, avisos y audiencias varían mucho.') },
  { title: tx(locale, 'Social Security', 'Seguro Social'), note: tx(locale, 'Free. Other agencies check your name against this record, so it comes next.', 'Gratis. Otras agencias comparan tu nombre con este registro, así que va después.') },
  { title: tx(locale, 'Driver’s license or state ID', 'Licencia o identificación estatal'), note: tx(locale, 'Some states also let you change the gender marker here.', 'Algunos estados también permiten cambiar el marcador de género aquí.') },
  { title: tx(locale, 'Passport', 'Pasaporte'), note: tx(locale, 'Name changes work. The sex marker is frozen while the lawsuit continues.', 'Los cambios de nombre funcionan. El marcador de sexo está congelado mientras sigue la demanda.') },
  { title: tx(locale, 'Birth certificate', 'Acta de nacimiento'), note: tx(locale, 'Handled by the state where you were born.', 'Lo maneja el estado donde naciste.') },
];
// Real counts from the content, recomputed on every build.
const n = states.length;
const count = (f: (s: StateBundle) => boolean) => states.filter(f).length;
const stats = [
  { v: count((s) => s.guides.drivers_license?.status === 'available'), l: tx(locale, 'let you change the marker on a driver’s license', 'permiten cambiar el marcador en la licencia') },
  { v: count((s) => s.guides.birth_certificate?.status === 'available'), l: tx(locale, 'let you change the marker on a birth certificate', 'permiten cambiar el marcador en el acta de nacimiento') },
  { v: count((s) => !!s.guides.drivers_license?.markers_available?.includes('X')), l: tx(locale, 'offer an X on a driver’s license', 'ofrecen X en la licencia') },
  { v: count((s) => !!s.meta.climate.shield_law), l: tx(locale, 'have a shield law protecting care', 'tienen una ley escudo que protege la atención') },
];
---
<section class="hero">
  <div class="hero-main">
    <h1>{tx(locale, 'Change your name, update your IDs, find care', 'Cambia tu nombre, actualiza tus documentos, encuentra atención')}</h1>
    <p class="lead">{tx(locale, 'Step-by-step guides for every state: the real forms, fees, and waivers, checked against official sources.', 'Guías paso a paso para cada estado: los formularios, tarifas y exenciones reales, verificados con fuentes oficiales.')}</p>
    <StatePicker states={states} locale={locale} />
  </div>
  <aside class="hero-side" aria-labelledby="fed-h">
    <h2 id="fed-h">{tx(locale, 'Federal documents right now', 'Documentos federales ahora mismo')}</h2>
    <p class="small muted">{tx(locale, 'The same in every state. You can update your name on all of them; the gender marker is a separate question.', 'Igual en todos los estados. Puedes actualizar tu nombre en todos; el marcador de género es otra pregunta.')}</p>
    <table class="fed-table">
      <caption class="visually-hidden">{tx(locale, 'Federal documents: name and gender marker', 'Documentos federales: nombre y marcador de género')}</caption>
      <thead><tr><th scope="col"><span class="visually-hidden">{tx(locale, 'Document', 'Documento')}</span></th><th scope="col">{tx(locale, 'Name', 'Nombre')}</th><th scope="col"><Term id="gender-marker" locale={locale}>{tx(locale, 'Gender marker', 'Marcador')}</Term></th></tr></thead>
      <tbody>
        {fed.map((g) => { const [name, marker] = docVerdict(g, locale); return (
          <tr>
            <th scope="row"><a href={localePath(locale, `federal/${g.guide_type.replace(/_/g, '-')}`)}>{_(`guide.${g.guide_type}` as const)}</a></th>
            <td><StatusChip status={name.status} locale={locale} variant="mark" size="sm" text={name.answer} /></td>
            <td><StatusChip status={marker.status} locale={locale} variant="mark" size="sm" text={marker.answer} /></td>
          </tr>
        ); })}
      </tbody>
    </table>
    <a class="small" href={localePath(locale, 'federal')}>{tx(locale, 'What each one allows, and why', 'Qué permite cada uno y por qué')}</a>
  </aside>
</section>

<section class="section" aria-labelledby="states-h">
  <h2 id="states-h" class="section-title">{tx(locale, 'Every state and territory', 'Todos los estados y territorios')}</h2>
  <StatesGrid states={states} locale={locale} picker={false} />
</section>

<section class="section" aria-labelledby="journey-h">
  <h2 id="journey-h" class="section-title">{tx(locale, 'The usual order', 'El orden habitual')}</h2>
  <p class="muted prose section-sub">{tx(locale, 'Most people update their documents in this sequence, because each office checks the one before it. Your state’s page shows its own rules for every step.', 'La mayoría actualiza sus documentos en este orden, porque cada oficina revisa la anterior. La página de tu estado muestra sus reglas para cada paso.')}</p>
  <Route items={journey} locale={locale} layout="row" />
</section>

<section class="section split" aria-labelledby="cmp-h">
  <div class="split-text">
    <h2 id="cmp-h" class="section-title">{tx(locale, 'The rules change at the state line', 'Las reglas cambian en la frontera estatal')}</h2>
    <p class="muted">{tx(locale, 'Useful if you are thinking about moving, or were born somewhere other than where you live.', 'Útil si piensas mudarte o naciste en un lugar distinto de donde vives.')}</p>
    <a class="btn secondary" href={localePath(locale, 'compare')}>{tx(locale, 'Compare states', 'Comparar estados')}<Icon name="arrow" size={18} /></a>
  </div>
  <dl class="stats">
    {stats.map((s) => <div><dt class="num">{s.v}<span class="of"> / {n}</span></dt><dd>{s.l}</dd></div>)}
  </dl>
</section>

<section class="section pair" aria-label={tx(locale, 'More', 'Más')}>
  <a href={localePath(locale, 'about') + '#paying'}>
    <span class="pair-title">{tx(locale, 'Help paying for it', 'Ayuda para pagar')}<Icon name="arrow" size={18} /></span>
    <span class="muted small">{tx(locale, 'Court fee waivers, free legal clinics, and funds for hormones, surgery, and document fees.', 'Exenciones de tarifas, clínicas legales gratuitas y fondos para hormonas, cirugía y documentos.')}</span>
  </a>
  <a href={localePath(locale, 'about') + '#how-we-verify'}>
    <span class="pair-title">{tx(locale, 'How we keep this current', 'Cómo lo mantenemos al día')}<Icon name="arrow" size={18} /></span>
    <span class="muted small">{tx(locale, 'Every claim links to its source. Official pages are checked weekly and flagged while a change is under review.', 'Cada dato enlaza a su fuente. Revisamos las páginas oficiales cada semana y las marcamos mientras un cambio está en revisión.')}</span>
  </a>
</section>
