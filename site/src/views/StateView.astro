---
import { t, type Locale } from '../i18n/ui';
import { lt, localePath, type StateBundle } from '../lib/content';
import { tx, firstSentence, type Status } from '../lib/text';
import { careVerdict } from '../lib/verdict';
import Verdict from '../components/Verdict.astro';
import Term from '../components/Term.astro';
import { routeFor } from '../lib/route';
import type { DocumentGuide } from '../types/content';
import StatusChip from '../components/StatusChip.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Sources from '../components/Sources.astro';
import Route from '../components/Route.astro';
import Md from '../components/Md.astro';
import Icon from '../components/Icon.astro';

const { state, federal, locale } = Astro.props as { state: StateBundle; federal: DocumentGuide[]; locale: Locale };
const _ = t(locale);
const m = state.meta;
const index = new Map(m.sources.map((s, i) => [s.id, i + 1]));
const base = `states/${state.code.toLowerCase()}`;
const name = lt(m.name, locale);
const stops = routeFor(state, federal, locale);
const careRows = state.care ? careVerdict(state.care, locale) : [];
const careNote = state.care ? firstSentence(lt(state.care.status_summary, locale), 220) : '';
const climate = (v: string) => (v === 'protective' ? 'available' : v === 'mixed' ? 'restricted' : 'prohibited') as Status;
const hasLocal = state.cities.length > 0, hasOrgs = !!m.key_resources?.length;
---
<dl class="climate">
  <div><dt>{_('climate.id_documents')}</dt><dd><StatusChip status={climate(m.climate.id_documents)} locale={locale} variant="mark" text={_(`climate.${m.climate.id_documents}` as const)} /></dd></div>
  <div><dt>{_('climate.care')}</dt><dd><StatusChip status={climate(m.climate.care)} locale={locale} variant="mark" text={_(`climate.${m.climate.care}` as const)} /></dd></div>
  <div><dt><Term id="shield-law" locale={locale}>{_('climate.shield_law')}</Term></dt><dd>{m.climate.shield_law ? tx(locale, 'Yes, protects care', 'Sí, protege la atención') : tx(locale, 'No', 'No')}</dd></div>
</dl>
{(() => { const full = lt(m.overview, locale); const lead = firstSentence(full, 400); const rest = full.replace(/\s+/g, ' ').trim().slice(lead.replace(/…$/, '').length).trim(); return rest.length > 60 && !lead.endsWith('…')
  ? <div class="overview"><p class="overview-lead">{lead}</p><details class="overview-more"><summary>{tx(locale, `More about ${name}`, `Más sobre ${name}`)}</summary><div class="prose"><Md text={rest} /></div></details></div>
  : <div class="prose overview"><Md text={full} /></div>; })()}
{m.review.status === 'draft' && <p class="verify-line"><Icon name="file" size={16} /><span>{tx(locale, 'This state’s pages are drafts written from official sources and not yet checked by a person.', 'Las páginas de este estado son borradores escritos a partir de fuentes oficiales y aún no revisados por una persona.')} <a href={`${localePath(locale, 'about')}#how-we-verify`}>{tx(locale, 'What this means', 'Qué significa')}</a></span></p>}

<section class="section" aria-labelledby="order-h">
  <h2 id="order-h" class="section-title">{tx(locale, `Your documents, in order`, `Tus documentos, en orden`)}</h2>
  <p class="muted prose section-sub">{tx(locale, 'Most people go in this order, because each office checks the one before it. On every document, updating your name and changing your gender marker are separate questions with separate answers.', 'La mayoría sigue este orden, porque cada oficina revisa la anterior. En cada documento, actualizar tu nombre y cambiar tu marcador de género son preguntas distintas con respuestas distintas.')}</p>
  <Route items={stops} locale={locale} label={tx(locale, `Documents in ${name}`, `Documentos en ${name}`)} />
  <p class="born-elsewhere"><Icon name="map" size={18} /><span>{tx(locale, `Born somewhere other than ${name}? Your birth certificate follows the state where you were born.`, `¿Naciste fuera de ${name}? Tu acta de nacimiento depende del estado donde naciste.`)} <a href={`${localePath(locale, 'states')}#states-filter`}>{tx(locale, 'Choose your birth state', 'Elige tu estado de nacimiento')}</a></span></p>
</section>

{careRows.length > 0 && (
  <section class="section" aria-labelledby="care-h">
    <h2 id="care-h" class="section-title">{tx(locale, 'Gender-affirming care', 'Atención de afirmación de género')}</h2>
    <a class="care-link" href={localePath(locale, `${base}/care`)}>
      <Verdict rows={careRows} locale={locale} variant="compact" terms={false} />
      <span class="stop-note">{careNote}</span>
      <span class="care-go">{tx(locale, 'Find clinics, health centers, telehealth, and ways to pay', 'Encuentra clínicas, centros de salud, telesalud y formas de pagar')}<Icon name="arrow" size={18} /></span>
    </a>
  </section>
)}

{(hasLocal || hasOrgs) && (
  <div class={`section help-grid ${hasLocal && hasOrgs ? 'two' : ''}`}>
    {hasLocal && (
      <section aria-labelledby="local-h">
        <h2 id="local-h" class="section-title">{tx(locale, 'Local help', 'Ayuda local')}</h2>
        <ul class="link-rows">
          {state.cities.map((c) => (
            <li><a href={localePath(locale, `${base}/local/${c.slug}`)}>
              <span><span class="stop-title">{c.name}</span><br /><span class="small muted">{tx(locale, `${c.resources.length} places for legal help, hormones, sexual health, and support`, `${c.resources.length} lugares de ayuda legal, hormonas, salud sexual y apoyo`)}</span></span>
              <Icon name="chevron" size={18} />
            </a></li>
          ))}
        </ul>
      </section>
    )}
    {hasOrgs && (
      <section aria-labelledby="orgs-h">
        <h2 id="orgs-h" class="section-title">{tx(locale, 'Statewide organizations', 'Organizaciones estatales')}</h2>
        <ul class="resources one">{m.key_resources!.map((r) => <ResourceCard r={r} locale={locale} index={index} />)}</ul>
      </section>
    )}
  </div>
)}

<details class="more section" data-sources>
  <summary>{tx(locale, `Sources for this page (${m.sources.length})`, `Fuentes de esta página (${m.sources.length})`)}</summary>
  <Sources sources={m.sources} locale={locale} id="state-sources" />
</details>
