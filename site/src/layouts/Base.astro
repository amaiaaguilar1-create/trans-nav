---
import '../styles/global.css';
import { t, type Locale } from '../i18n/ui';
import { localePath, BASE } from '../lib/content';
import { tx } from '../lib/text';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Path without locale prefix, e.g. "states/ca/name-change", used for the language switcher and hreflang. */
  path: string;
  /** Top-level section for aria-current in the nav. */
  section?: 'states' | 'federal' | 'compare' | 'about' | 'home';
}
const { title, description, locale, path, section } = Astro.props;
const _ = t(locale);
const other: Locale = locale === 'en' ? 'es' : 'en';
const site = Astro.site ? new URL(Astro.site).origin : '';
const REPO = 'https://github.com/amaiaaguilar1-create/trans-nav';
const name = _('site.name');
const nav = [
  { key: 'states', href: localePath(locale, 'states'), label: tx(locale, 'States', 'Estados') },
  { key: 'federal', href: localePath(locale, 'federal'), label: tx(locale, 'Federal IDs', 'Documentos federales') },
  { key: 'compare', href: localePath(locale, 'compare'), label: tx(locale, 'Compare states', 'Comparar estados') },
  { key: 'about', href: localePath(locale, 'about'), label: _('nav.about') },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15171c" />
    <meta name="referrer" content="no-referrer" />
    <meta name="generator" content={Astro.generator} />
    <title>{title === name ? name : `${title} · ${name}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={site + localePath('en', path)} />
    <link rel="alternate" hreflang="es" href={site + localePath('es', path)} />
    <link rel="alternate" hreflang="x-default" href={site + localePath('en', path)} />
  </head>
  <body>
    <a class="visually-hidden" href="#main" style="position:absolute" onfocus="this.classList.remove('visually-hidden')" onblur="this.classList.add('visually-hidden')">{_('nav.skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={localePath(locale, '')}>
          <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><rect width="28" height="28" rx="7" fill="var(--accent)"/><path d="M8 19c3-9 9-1 12-10" fill="none" stroke="var(--on-accent)" stroke-width="2.4" stroke-linecap="round"/><circle cx="8" cy="19" r="2.2" fill="var(--on-accent)"/><circle cx="20" cy="9" r="2.2" fill="var(--on-accent)"/></svg>
          <span>{name}</span>
        </a>
        <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false"><Icon name="menu" size={20} label={tx(locale, 'Menu', 'Menú')} /></button>
        <nav class="nav" id="site-nav" aria-label={tx(locale, 'Main', 'Principal')}>
          {nav.map((n) => <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>)}
          <a class="lang" href={localePath(other, path)} lang={other} hreflang={other}>{_('nav.language')}</a>
        </nav>
        <button class="exit-btn" type="button" data-exit title={_('exit.hint')}><Icon name="exit" size={16} />{_('exit.label')}<span class="exit-hint">Esc Esc</span></button>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <section>
            <h2>{tx(locale, 'Find information', 'Buscar información')}</h2>
            <ul>
              <li><a href={localePath(locale, 'states')}>{tx(locale, 'All states and territories', 'Todos los estados y territorios')}</a></li>
              <li><a href={localePath(locale, 'federal')}>{tx(locale, 'Passport, Social Security, immigration', 'Pasaporte, Seguro Social, inmigración')}</a></li>
              <li><a href={localePath(locale, 'compare')}>{tx(locale, 'Compare states', 'Comparar estados')}</a></li>
            </ul>
          </section>
          <section>
            <h2>{tx(locale, 'About this site', 'Sobre este sitio')}</h2>
            <ul>
              <li><a href={localePath(locale, 'about')}>{tx(locale, 'How we keep it current', 'Cómo lo mantenemos al día')}</a></li>
              <li><a href={localePath(locale, 'privacy')}>{_('footer.privacy')}</a></li>
              <li><a href={`${REPO}/issues/new?labels=report&template=outdated.md`} rel="noopener">{_('footer.report')}</a></li>
              <li><a href={REPO} rel="noopener">{_('footer.source')}</a></li>
            </ul>
          </section>
          <section>
            <h2>{tx(locale, 'Need to talk now?', '¿Necesitas hablar ahora?')}</h2>
            <p style="margin:0">{tx(locale, 'Trans Lifeline is a peer support line run by trans people.', 'Trans Lifeline es una línea de apoyo entre pares dirigida por personas trans.')}<br /><a href="tel:8775658860" class="num">877-565-8860</a></p>
          </section>
        </div>
        <p class="fine">{_('disclaimer')}</p>
      </div>
    </footer>

    <button class="exit-btn exit-float" type="button" data-exit aria-label={_('exit.label')}><Icon name="exit" size={18} />{_('exit.label')}</button>

    <script>
      // Quick exit: button or Escape twice within 1.5s. Replaces this history entry so Back does not return here.
      const leave = () => { try { window.open('https://www.google.com/', '_blank'); } catch {} location.replace('https://www.weather.gov/'); };
      document.querySelectorAll('[data-exit]').forEach((b) => b.addEventListener('click', leave));
      let last = 0;
      addEventListener('keydown', (e) => { if (e.key !== 'Escape') return; const now = Date.now(); if (now - last < 1500) leave(); last = now; });
      // Mobile menu
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn'), nav = document.getElementById('site-nav');
      btn?.addEventListener('click', () => { const open = nav!.classList.toggle('open'); btn.setAttribute('aria-expanded', String(open)); });
    </script>
  </body>
</html>
