---
/** Renders superscript citation links [1][2] pointing at the Sources list. */
const { ids, index } = Astro.props as { ids?: string[]; index: Map<string, number> };
---
{ids && ids.length > 0 && (
  <sup class="cite">
    {ids.map((id) => index.has(id) ? <a href={`#src-${id}`} title={id}>[{index.get(id)}]</a> : null)}
  </sup>
)}
