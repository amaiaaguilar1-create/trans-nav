---
/** Superscript citation links pointing at the Sources list. */
const { ids, index } = Astro.props as { ids?: string[]; index: Map<string, number> };
const nums = (ids ?? []).filter((id) => index.has(id)).map((id) => [id, index.get(id)!] as const);
---
{nums.length > 0 && (
  <sup class="cite">{nums.map(([id, n]) => <a href={`#src-${id}`} aria-label={`Source ${n}`}>[{n}]</a>)}</sup>
)}
