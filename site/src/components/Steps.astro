---
import { t, type Locale } from '../i18n/ui';
import { lt } from '../lib/content';
import Md from './Md.astro';
import Cite from './Cite.astro';
import Icon from './Icon.astro';
import type { Step, Form, Fee } from '../types/content';
const { steps, forms = [], fees = [], locale, index } = Astro.props as { steps: Step[]; forms?: Form[]; fees?: Fee[]; locale: Locale; index: Map<string, number> };
const _ = t(locale);
const formById = new Map(forms.map((f) => [f.id, f]));
// Some drafts use slugs ("fingerprint-card") as form ids; show the form's name instead of a slug.
const formLabel = (f: Form) => (/^[a-z0-9-]+$/.test(f.id) ? lt(f.name, locale) : f.id);
const feeById = new Map(fees.map((f) => [f.id, f]));
const money = (n: number) => new Intl.NumberFormat(locale === 'es' ? 'es-US' : 'en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: n % 1 ? 2 : 0 }).format(n);
---
<ol class="steps">
  {steps.map((s) => (
    <li id={`step-${s.id}`}>
      <h3>{lt(s.title, locale)}{s.optional && <span class="tag" style="margin-left:.5rem;vertical-align:middle">{_('form.required.optional')}</span>}<Cite ids={s.sources} index={index} /></h3>
      <div class="body"><Md text={lt(s.body, locale)} /></div>
      {(s.forms?.length || s.fees?.length || s.estimated_time) && (
        <div class="meta">
          {s.forms?.map((id) => { const f = formById.get(id); return f ? <a class="meta-item" href={`#form-${id.replace(/\s+/g, '-')}`}><Icon name="file" size={14} />{formLabel(f)}</a> : null; })}
          {s.fees?.map((id) => { const f = feeById.get(id); return f && typeof f.amount === 'number' ? <a class="meta-item num" href="#costs">{money(f.amount)} · {lt(f.label, locale)}</a> : null; })}
          {s.estimated_time && <span class="meta-item"><Icon name="clock" size={14} />{lt(s.estimated_time, locale)}</span>}
        </div>
      )}
    </li>
  ))}
</ol>
