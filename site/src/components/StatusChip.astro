---
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n/ui';
import { statusShort, type Status } from '../lib/text';
const { status, locale, label, short = false, size = 'md' } = Astro.props as { status: Status; locale: Locale; label?: string; short?: boolean; size?: 'md' | 'sm' };
const _ = t(locale);
const icon = { available: 'check', restricted: 'alert', prohibited: 'x', litigation: 'scale', unclear: 'help' }[status] as 'check';
const word = short ? statusShort[status][locale] : _(`status.${status}` as const);
---
<span class={`chip ${status} ${size === 'sm' ? 'sm' : ''}`}><Icon name={icon} size={size === 'sm' ? 12 : 14} />{label ? `${label}: ` : ''}{word}</span>
