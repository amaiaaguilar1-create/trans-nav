---
import { t, type Locale } from '../i18n/ui';
import { daysSince, OVERDUE_DAYS } from '../lib/content';
interface Review { status: 'draft' | 'reviewed'; last_verified: string; es_status?: string }
const { review, locale } = Astro.props as { review: Review; locale: Locale };
const _ = t(locale);
const overdue = review.status === 'reviewed' && daysSince(review.last_verified) > OVERDUE_DAYS;
const cls = overdue ? 'overdue' : review.status;
const label = overdue ? _('review.overdue') : review.status === 'reviewed' ? _('review.reviewed') : _('review.draft');
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(review.last_verified + 'T00:00:00Z'));
---
<span class={`pill ${cls}`}>{label}</span>
<span class="small">{_('review.last_verified')}: <time datetime={review.last_verified}>{date}</time></span>
