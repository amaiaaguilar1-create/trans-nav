---
/**
 * Searchable list of HRSA community health centers for one state. Data is a static JSON file; filtering and the
 * optional "near me" sort run entirely in the browser. Location is never sent anywhere.
 * States: loading (skeleton rows), loaded, no results, and failed to load (with a link to HRSA's own finder).
 */
import { BASE } from '../lib/content';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/ui';
const { code, locale } = Astro.props as { code: string; locale: Locale };
const es = locale === 'es';
const L = {
  h: es ? 'Centros de salud comunitarios cerca de ti' : 'Community health centers near you',
  intro: es
    ? 'Estos centros con financiamiento federal deben atenderte aunque no tengas seguro y cobran según tus ingresos. Muchos, pero no todos, recetan terapia hormonal. Llama y pregunta por "atención de afirmación de género" o "terapia hormonal".'
    : 'These federally funded centers must see you whether or not you have insurance, and charge based on income. Many, but not all, prescribe hormone therapy. Call and ask for "gender-affirming care" or "hormone therapy."',
  label: es ? 'Busca por ciudad, condado o código postal' : 'Search by city, county, or ZIP code',
  ph: es ? 'Por ejemplo, Fresno o 93721' : 'For example, Fresno or 93721',
  near: es ? 'Ordenar por cercanía' : 'Sort by distance from me',
  nearNote: es ? 'Ordenar por cercanía usa tu ubicación solo en este dispositivo. No se envía a ningún lugar.' : 'Sorting by distance uses your location only on this device. It is never sent anywhere.',
  nearOn: es ? 'Ordenado por cercanía.' : 'Sorted by distance.',
  nearFail: es ? 'No pudimos obtener tu ubicación. Busca por ciudad o código postal.' : 'We could not get your location. Search by city or ZIP code instead.',
  more: es ? 'Mostrar más' : 'Show more',
  loading: es ? 'Cargando centros de salud' : 'Loading health centers',
  none: es ? 'No hay resultados. Prueba con una ciudad cercana o el nombre del condado.' : 'No matches. Try a nearby city or the county name.',
  fail: es ? 'No pudimos cargar la lista de centros de salud.' : 'We could not load the list of health centers.',
  failLink: es ? 'Busca en el buscador oficial de HRSA' : 'Search HRSA’s official finder',
  src: es ? 'Fuente: HRSA, actualizado' : 'Source: HRSA, updated',
  sites: es ? 'sitios en este estado' : 'sites in this state',
  hrs: es ? 'h por semana' : 'hours a week',
  away: es ? 'de distancia' : 'away',
  mi: 'mi',
  matches: es ? 'resultados' : 'matches',
  match: es ? 'resultado' : 'match',
  call: es ? 'Llamar' : 'Call',
};
---
<section class="hc" id="health-centers" data-url={`${BASE}data/health-centers/${code}.json`} data-l={JSON.stringify(L)} aria-labelledby={`hc-h-${code}`}>
  <h2 id={`hc-h-${code}`}>{L.h}</h2>
  <p class="prose muted">{L.intro}</p>
  <div class="hc-controls hc-v2">
    <div class="hc-field">
      <label for={`hc-q-${code}`}>{L.label}</label>
      <input id={`hc-q-${code}`} class="hc-q" type="search" placeholder={L.ph} autocomplete="off" inputmode="search" enterkeyhint="search" />
    </div>
    <div class="hc-near-wrap">
      <button class="hc-near btn secondary sm" type="button" aria-describedby={`hc-note-${code}`}><Icon name="locate" size={16} />{L.near}</button>
      <p class="hc-note" id={`hc-note-${code}`}>{L.nearNote}</p>
    </div>
  </div>
  <p class="hc-count" aria-live="polite"></p>
  <ul class="resources hc-list" aria-busy="true">
    {[0, 1, 2, 3].map(() => <li class="hc-skel" aria-hidden="true"><span></span><span></span><span></span></li>)}
    <li class="visually-hidden">{L.loading}</li>
  </ul>
  <div class="hc-fail" hidden>
    <p><strong>{L.fail}</strong> <a href="https://findahealthcenter.hrsa.gov/" rel="noopener">{L.failLink}</a></p>
  </div>
  <p><button class="hc-more btn secondary sm" type="button" hidden>{L.more}</button></p>
  <p class="xs muted hc-src"></p>
</section>
<script>
  type Site = { n: string; o: string; a: string; c: string; z: string; co?: string; p?: string; w?: string; h?: number; lat?: number; lon?: number; d?: number };
  // HRSA stores many names in ALL CAPS; show them in title case.
  const tc = (s: string) => (s && s === s.toUpperCase() ? s.toLowerCase().replace(/\b([a-z])/g, (m) => m.toUpperCase()).replace(/\b(Inc|Llc|Of|And|The|Dba)\b/g, (m) => m.toLowerCase()).replace(/^./, (c) => c.toUpperCase()) : s);
  const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);
  const miles = (a: number, b: number, c: number, d: number) => {
    const r = Math.PI / 180, x = Math.sin(((c - a) * r) / 2) ** 2 + Math.cos(a * r) * Math.cos(c * r) * Math.sin(((d - b) * r) / 2) ** 2;
    return 3958.8 * 2 * Math.asin(Math.sqrt(x));
  };
  const phoneIcon = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>';
  for (const root of document.querySelectorAll<HTMLElement>('section.hc')) {
    const L = JSON.parse(root.dataset.l!);
    const list = root.querySelector<HTMLElement>('.hc-list')!, q = root.querySelector<HTMLInputElement>('.hc-q')!;
    const more = root.querySelector<HTMLButtonElement>('.hc-more')!, near = root.querySelector<HTMLButtonElement>('.hc-near')!;
    const count = root.querySelector<HTMLElement>('.hc-count')!, note = root.querySelector<HTMLElement>('.hc-note')!;
    const fmt = new Intl.NumberFormat(document.documentElement.lang || 'en');
    let sites: Site[] = [], shown = 12, sortByDist = false;
    const render = () => {
      const t = q.value.trim().toLowerCase();
      let r = t ? sites.filter((s) => `${s.c} ${s.co ?? ''} ${s.z} ${s.n} ${s.o}`.toLowerCase().includes(t)) : sites;
      if (sortByDist) r = [...r].sort((a, b) => (a.d ?? 1e9) - (b.d ?? 1e9));
      list.innerHTML = r.length ? r.slice(0, shown).map((s) => `
        <li class="res">
          <h3 class="res-name">${s.w ? `<a href="${esc(s.w)}" rel="noopener">${esc(tc(s.n))}</a>` : esc(tc(s.n))}</h3>
          ${tc(s.o) !== tc(s.n) ? `<p class="res-desc">${esc(tc(s.o))}</p>` : ''}
          <div class="res-contact">
            ${s.p ? `<a class="res-phone num" href="tel:${s.p.replace(/\D/g, '')}" aria-label="${esc(L.call)} ${esc(s.p)}">${phoneIcon}${esc(s.p)}</a>` : ''}
            <span class="res-addr">${esc(s.a)}, ${esc(s.c)} ${esc(s.z)}</span>
            ${s.d !== undefined && sortByDist ? `<span class="res-dist num">${s.d.toFixed(1)} ${L.mi} ${L.away}</span>` : ''}
            ${s.h ? `<span class="res-lang num">${s.h} ${L.hrs}</span>` : ''}
          </div>
        </li>`).join('') : `<li class="hc-none"><p>${L.none}</p></li>`;
      list.removeAttribute('aria-busy');
      count.textContent = t ? `${fmt.format(r.length)} ${r.length === 1 ? L.match : L.matches}` : '';
      more.hidden = r.length <= shown;
    };
    fetch(root.dataset.url!).then((x) => { if (!x.ok) throw new Error(String(x.status)); return x.json(); }).then((d) => {
      sites = d.sites; root.querySelector<HTMLElement>('.hc-src')!.textContent = `${L.src} ${d.fetched}. ${fmt.format(d.count)} ${L.sites}.`; render();
    }).catch(() => {
      list.hidden = true; list.removeAttribute('aria-busy');
      root.querySelector<HTMLElement>('.hc-controls')!.hidden = true;
      root.querySelector<HTMLElement>('.hc-fail')!.hidden = false;
    });
    q.addEventListener('input', () => { shown = 12; render(); });
    more.addEventListener('click', () => { shown += 24; render(); });
    near.addEventListener('click', () => {
      if (!navigator.geolocation) { note.textContent = L.nearFail; return; }
      navigator.geolocation.getCurrentPosition((pos) => {
        const { latitude: la, longitude: lo } = pos.coords;
        for (const s of sites) if (s.lat !== undefined && s.lon !== undefined) s.d = miles(la, lo, s.lat, s.lon);
        sortByDist = true; shown = 12; near.setAttribute('aria-pressed', 'true'); note.textContent = `${L.nearOn} ${L.nearNote}`; render();
      }, () => { note.textContent = L.nearFail; });
    });
  }
</script>
