---
/**
 * Costs. A table on wide screens; on phones each fee becomes its own row (label, amount, then notes) so nothing scrolls sideways.
 */
import { t, type Locale } from '../i18n/ui';
import { lt } from '../lib/content';
import { tx } from '../lib/text';
import Cite from './Cite.astro';
import Icon from './Icon.astro';
import type { Fee } from '../types/content';
const { fees, locale, index } = Astro.props as { fees: Fee[]; locale: Locale; index: Map<string, number> };
const _ = t(locale);
const money = (n: number) => new Intl.NumberFormat(locale === 'es' ? 'es-US' : 'en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: n % 1 ? 2 : 0 }).format(n);
const amount = (f: Fee) => typeof f.amount === 'number' ? (f.amount === 0 ? tx(locale, 'Free', 'Gratis') : money(f.amount)) : typeof f.min === 'number' && typeof f.max === 'number' ? `${money(f.min)}-${money(f.max)}` : typeof f.min === 'number' ? `${money(f.min)}+` : tx(locale, 'Varies', 'Varía');
const H = { what: tx(locale, 'What', 'Concepto'), cost: tx(locale, 'Cost', 'Costo'), notes: tx(locale, 'Notes', 'Notas') };
---
<div class="fees-v2">
  <table class="data fees-table">
    <caption class="visually-hidden">{tx(locale, 'Fees for this process', 'Tarifas de este trámite')}</caption>
    <thead><tr><th scope="col">{H.what}</th><th scope="col" class="money">{H.cost}</th><th scope="col">{H.notes}</th></tr></thead>
    <tbody>
      {fees.map((f) => (
        <tr>
          <th scope="row">{lt(f.label, locale)}<Cite ids={f.sources} index={index} /></th>
          <td class="money num" data-label={H.cost}>{amount(f)}</td>
          <td class="fee-notes" data-label={H.notes}>
            {(f.waivable || f.varies_by) && (
              <span class="fee-flags">
                {f.waivable && <span class="fee-flag waivable"><Icon name="check" size={14} />{tx(locale, 'Can be waived', 'Se puede exentar')}</span>}
                {f.varies_by && <span class="fee-flag">{tx(locale, 'Varies by', 'Varía según')} {_(`fee.by.${f.varies_by}` as const)}</span>}
              </span>
            )}
            {f.note && <span class="fee-note">{lt(f.note, locale)}</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
