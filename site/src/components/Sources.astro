---
import { t, type Locale } from '../i18n/ui';
import { tx } from '../lib/text';
interface Source { id: string; url: string; title: string; publisher?: string; kind: string; accessed: string; quote?: string }
/** collapsible: the list sits in a closed disclosure and opens itself when a citation like [3] is followed. */
const { sources, locale, id = 'sources', collapsible = false } = Astro.props as { sources: Source[]; locale: Locale; id?: string; collapsible?: boolean };
const _ = t(locale);
const kind: Record<string, [string, string]> = {
  official: ['Official page', 'Página oficial'], statute: ['Law', 'Ley'], regulation: ['Regulation', 'Reglamento'], court: ['Court', 'Tribunal'],
  form: ['Form', 'Formulario'], org: ['Organization', 'Organización'], news: ['News', 'Noticias'], community: ['Community', 'Comunidad'],
};
const intro = tx(locale, `${sources.length} sources. Numbers in the text, like [1], point here.`, `${sources.length} fuentes. Los números en el texto, como [1], apuntan aquí.`);
---
<section id={id} aria-labelledby={`${id}-h`} class="sources-section">
  <h2 id={`${id}-h`}>{_('section.sources')}</h2>
  {collapsible ? (
    <details class="sources-box" data-sources>
      <summary><span>{intro}</span><span class="sources-open">{tx(locale, 'Show all', 'Mostrar todas')}</span></summary>
      <ol class="sources">
        {sources.map((s) => (
          <li id={`src-${s.id}`}>
            <a href={s.url} rel="noopener">{s.title}</a>
            <span class="src-meta">{[s.publisher, kind[s.kind] ? tx(locale, kind[s.kind][0], kind[s.kind][1]) : s.kind].filter(Boolean).join(', ')}. {_('source.accessed')} <time class="num" datetime={s.accessed}>{s.accessed}</time></span>
            {s.quote && <blockquote>“{s.quote}”</blockquote>}
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <>
      <p class="small muted">{intro}</p>
      <ol class="sources">
        {sources.map((s) => (
          <li id={`src-${s.id}`}>
            <a href={s.url} rel="noopener">{s.title}</a>
            <span class="src-meta">{[s.publisher, kind[s.kind] ? tx(locale, kind[s.kind][0], kind[s.kind][1]) : s.kind].filter(Boolean).join(', ')}. {_('source.accessed')} <time class="num" datetime={s.accessed}>{s.accessed}</time></span>
            {s.quote && <blockquote>“{s.quote}”</blockquote>}
          </li>
        ))}
      </ol>
    </>
  )}
</section>
<script>
  // Open the containing disclosure when a citation link or a #src- URL targets a source inside it.
  const reveal = () => {
    const el = location.hash.startsWith('#src-') ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const box = el?.closest('details');
    if (el && box && !box.open) { box.open = true; el.scrollIntoView(); }
  };
  addEventListener('hashchange', reveal);
  document.addEventListener('click', (e) => { const a = (e.target as Element).closest?.('a[href^="#src-"]'); if (a) { const box = document.getElementById(a.getAttribute('href')!.slice(1))?.closest('details'); if (box) box.open = true; } });
  reveal();
</script>
