---
/** End-of-guide navigation along the route: where you are, what comes next, and the way back to the state hub. */
import Icon from './Icon.astro';
import StatusChip from './StatusChip.astro';
import type { Locale } from '../i18n/ui';
import type { Stop } from '../lib/route';
import { tx } from '../lib/text';
const { prev, next, hub, hubLabel, locale } = Astro.props as { prev?: Stop; next?: Stop; hub: string; hubLabel: string; locale: Locale };
---
<nav class="next-stop" aria-label={tx(locale, 'Your route', 'Tu ruta')}>
  {next ? (
    <a class="next-main" href={next.href}>
      <span class="next-label">{tx(locale, 'Next stop', 'Siguiente paso')}</span>
      <span class="next-title">{next.title}</span>
      <span class="next-meta"><StatusChip status={next.status} locale={locale} short variant="mark" size="sm" /><span class="muted small">{next.scope}</span></span>
      <span class="next-arrow" aria-hidden="true"><Icon name="arrow" size={22} /></span>
    </a>
  ) : (
    <a class="next-main" href={hub}>
      <span class="next-label">{tx(locale, 'That is the last document on the route', 'Ese es el último documento de la ruta')}</span>
      <span class="next-title">{hubLabel}</span>
      <span class="next-meta"><span class="muted small">{tx(locale, 'Care, local help, and organizations', 'Atención, ayuda local y organizaciones')}</span></span>
      <span class="next-arrow" aria-hidden="true"><Icon name="arrow" size={22} /></span>
    </a>
  )}
  <div class="next-side">
    {prev && <a href={prev.href}><span class="xs muted">{tx(locale, 'Previous', 'Anterior')}</span><br />{prev.title}</a>}
    {next && <a href={hub}><span class="xs muted">{tx(locale, 'Whole route', 'Ruta completa')}</span><br />{hubLabel}</a>}
  </div>
</nav>
