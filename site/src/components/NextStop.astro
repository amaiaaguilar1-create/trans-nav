---
/** End of a guide: the next document on the route, previewed with its own answers, plus the way back. */
import Icon from './Icon.astro';
import Verdict from './Verdict.astro';
import type { Locale } from '../i18n/ui';
import type { Stop } from '../lib/route';
import { tx } from '../lib/text';
const { prev, next, hub, state, locale } = Astro.props as { prev?: Stop; next?: Stop; hub: string; state: string; locale: Locale };
---
<nav class="next-stop" aria-label={tx(locale, 'Continue your route', 'Continúa tu ruta')}>
  <a class="next-main" href={next ? next.href : hub}>
    <span class="next-label">{next ? tx(locale, 'Next stop', 'Siguiente paso') : tx(locale, 'You have reached the end of the document route', 'Llegaste al final de la ruta de documentos')}</span>
    <span class="next-title">{next ? next.title : tx(locale, `Care and local help in ${state}`, `Atención y ayuda local en ${state}`)}</span>
    {next && <span class="next-scope">{next.scope}</span>}
    {next && <Verdict rows={next.verdict} locale={locale} variant="compact" terms={false} />}
    <span class="next-arrow" aria-hidden="true"><Icon name="arrow" size={24} /></span>
  </a>
  <div class="next-side">
    {prev && <a href={prev.href}><span class="next-side-label">{tx(locale, 'Previous', 'Anterior')}</span>{prev.title}</a>}
    <a href={hub}><span class="next-side-label">{tx(locale, 'All steps', 'Todos los pasos')}</span>{tx(locale, `${state} overview`, `Resumen de ${state}`)}</a>
  </div>
</nav>
