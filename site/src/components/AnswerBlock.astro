---
/** Layer one of every guide: the separate answers, a plain summary, the facts people plan around, and how sure we are. */
import { t, type Locale } from '../i18n/ui';
import { lt, localePath, daysSince, OVERDUE_DAYS, type LocalizedText } from '../lib/content';
import { tx } from '../lib/text';
import type { VerdictRow } from '../lib/verdict';
import Verdict from './Verdict.astro';
import Icon from './Icon.astro';
import Md from './Md.astro';

interface Fact { label: string; value: string }
interface Props {
  locale: Locale;
  verdict: VerdictRow[];
  summary: LocalizedText;
  review: { status: 'draft' | 'reviewed'; last_verified: string; es_status?: string };
  facts?: Fact[];
}
const { locale, verdict, summary, review, facts = [] } = Astro.props;
const _ = t(locale);
const overdue = review.status === 'reviewed' && daysSince(review.last_verified) > OVERDUE_DAYS;
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(review.last_verified + 'T00:00:00Z'));
const state = overdue ? 'bad' : review.status === 'reviewed' ? 'ok' : 'draft';
const reviewText = overdue
  ? tx(locale, `Verified ${date}, now overdue for a re-check.`, `Verificado el ${date}; necesita una nueva revisión.`)
  : review.status === 'reviewed'
    ? tx(locale, `Verified by a person on ${date}.`, `Verificado por una persona el ${date}.`)
    : tx(locale, `Draft from official sources, ${date}. Not yet checked by a person.`, `Borrador de fuentes oficiales, ${date}. Aún no revisado por una persona.`);
---
<section class="answer" aria-label={tx(locale, 'The short answer', 'La respuesta corta')}>
  <Verdict rows={verdict} locale={locale} variant="full" />
  <div class="answer-summary"><Md text={lt(summary, locale)} /></div>
  {facts.length > 0 && <dl class="facts">{facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>}
  <p class={`verify-line ${state}`}>
    <Icon name={state === 'ok' ? 'check' : state === 'bad' ? 'alert' : 'file'} size={16} />
    <span>{reviewText} <a href={`${localePath(locale, 'about')}#how-we-verify`}>{tx(locale, 'How we verify', 'Cómo verificamos')}</a>{locale === 'es' && review.es_status !== 'reviewed' && <> {_('review.es_machine')}</>}</span>
  </p>
</section>
